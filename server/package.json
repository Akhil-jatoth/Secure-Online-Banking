{
  "name": "secure-online-banking-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Secure Online Banking System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
